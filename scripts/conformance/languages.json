      "domains": ["web"],
      "markerFiles": {
        "package.json": "{ \"name\": \"demo-tests\", \"private\": true }\n",
        "tsconfig.json": "{ \"compilerOptions\": { \"strict\": true } }\n"
      }
    }
  ]
}
