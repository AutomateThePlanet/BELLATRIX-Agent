<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Bellatrix.Execution</RootNamespace>
    <AssemblyName>Bellatrix.Execution</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bellatrix.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Protocol-agnostic driver engine: shared by the CLI and the retained MCP shim. -->
    <PackageReference Include="Appium.WebDriver" Version="5.1.0" />
    <!-- Web domain (Selenium). Pinned to the Selenium version Appium 5.1.0 already resolves (4.23.0)
         so desktop/mobile are not disturbed; WebDriverManager fetches local browser-driver binaries. -->
    <PackageReference Include="Selenium.Support" Version="4.23.0" />
    <PackageReference Include="WebDriverManager" Version="2.17.6" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>
</Project>
