{
  "$comment": "Generic rules for what must never appear in this public repository (PublicSafetyGuardTests): local machine paths, secret-shaped strings, links to repositories that are not public, and email addresses outside the documented allow-list. Each `pattern` is a .NET regular expression matched against every line of every tracked text file.",
  "regex": [
    { "id": "windows-dev-path", "pattern": "(?i)\\b[a-z]:[\\\\/](sourcecode|users|temp)[\\\\/]" },
    { "id": "msys-dev-path", "pattern": "(?i)(^|[\\s\"'(=])/[a-z]/(sourcecode|users)/" },
    { "id": "unix-home-path", "pattern": "(^|[\\s\"'(=])/(home|Users)/[a-z][a-z0-9_.-]+/" },
    { "id": "local-nuget-feed", "pattern": "(?i)nuget-local" },
    { "id": "non-public-repository-link", "pattern": "(?i)github(usercontent)?\\.com/AutomateThePlanet/(?!(BELLATRIX|BELLATRIX-Java|BELLATRIX-JavaScript|BELLATRIX-Agent|Spectra)(?![A-Za-z0-9_.-]))[A-Za-z0-9_.-]+" },
    { "id": "email-address", "pattern": "(?i)\\b[a-z0-9._%+-]+@(?!(example\\.(com|org|net)|bellatrix\\.solutions)\\b)[a-z0-9-]+(\\.[a-z0-9-]+)*\\.[a-z]{2,}\\b" },
    { "id": "aws-access-key", "pattern": "\\bAKIA[0-9A-Z]{16}\\b" },
    { "id": "github-token", "pattern": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{40,}" },
    { "id": "slack-token", "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}" },
    { "id": "openai-or-anthropic-key", "pattern": "\\bsk-(ant-)?[A-Za-z0-9_-]{32,}" },
    { "id": "google-api-key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "private-key-block", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "id": "assigned-secret", "pattern": "(?i)\\b(api[_-]?key|secret|password|access[_-]?token)\\b\\s*[:=]\\s*[\"'][^\"'\\s<>{}$]{12,}[\"']" }
  ]
}
